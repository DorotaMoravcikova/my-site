<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dorota Moravčíková</title>
    <meta
      name="description"
      content="Master's student in Cognitive Science at the University of Amsterdam and research assistant at Leiden University."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <img
        class="photo"
        src="/me.jpg"
        alt="Portrait of Dorota Moravčíková"
        width="180"
        height="180"
      />
      <h1>Dorota Moravčíková</h1>
      <p>
        Hi, I am Dorota. I am currently doing my master's in Cognitive Science at the University of Amsterdam and working as a research assistant at the Leiden Institute of Advanced Computer Science.
      </p>
      <nav>
        <a href="/cv.pdf">CV</a>
        <a href="https://www.linkedin.com/in/dorota-moravcikova/">LinkedIn</a>
        <a href="https://goodreads.com/dorotamoravcikova">Goodreads</a>
        <a href="https://letterboxd.com/neuroticafiles/">Letterboxd</a>
      </nav>
    </main>
  </body>
</html>

<style is:global>
 :root {
  --bg: #0a0a0a;
  --text: #f2f0ea;
  --accent: #f2f0ea;
  --dim: #4a4a45;
}
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--text);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    line-height: 1.6;
  }
  main {
    max-width: 34rem;
    padding: 3rem 1.5rem;
    text-align: center;
  }
  .photo {
    width: 180px;
    height: 180px;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--dim);
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: clamp(1.8rem, 6vw, 2.5rem);
    letter-spacing: -0.01em;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  p {
    margin: 0 0 1rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.5rem;
    margin-top: 2rem;
  }
  a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--dim);
    padding-bottom: 2px;
  }
  a:hover,
  a:focus-visible {
    border-bottom-color: var(--accent);
  }
</style>
